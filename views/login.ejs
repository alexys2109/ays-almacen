<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <title>Iniciar sesión</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#1e2633">
    <link rel="icon" type="image/png" href="/img/favicon-64.png">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Precios AYS">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="preload" href="/vendor/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/vendor/bootstrap/bootstrap.min.css?v=<%= vend %>" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= vend %>">
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= ver %>">
    <style>
        .cuenta-box { display: flex; align-items: center; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; background: var(--surface); position: relative; transition: border-color .15s, background .15s; }
        .cuenta-box:hover { border-color: #b3c3dc; background: var(--navy-faint); }
        .cuenta-box .cuenta-main { flex: 1; display: flex; align-items: center; gap: 12px; padding: 11px 12px; cursor: pointer; background: none; border: 0; text-align: left; min-width: 0; font-family: inherit; }
        .cuenta-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--navy-soft); color: var(--navy); font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .cuenta-user { font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .cuenta-menu-btn { border: 0; background: none; padding: 10px 14px; color: var(--text-faint); font-size: 1rem; cursor: pointer; }
        .cuenta-menu-btn:hover { color: var(--text); }
        .cuenta-menu { position: absolute; right: 8px; top: 100%; z-index: 5; background: #fff; border: 1px solid var(--border); border-radius: 10px; box-shadow: var(--shadow-md); display: none; overflow: hidden; }
        .cuenta-menu.abierto { display: block; }
        .cuenta-menu button { border: 0; background: none; padding: 10px 16px; color: var(--red); width: 100%; white-space: nowrap; font-size: .88rem; font-weight: 500; }
        .cuenta-menu button:hover { background: var(--red-soft); }
        .separador { display: flex; align-items: center; gap: 12px; color: var(--text-faint); font-size: .8rem; margin: 18px 0 4px; }
        .separador::before, .separador::after { content: ''; flex: 1; height: 1px; background: var(--border); }
        .toggle-clave { cursor: pointer; border-radius: 0 10px 10px 0; background: #fff; color: var(--text-faint); }
        .toggle-clave:hover { color: var(--text); }
    </style>
</head>

<body class="login-body">

    <div class="login-card">
        <img src="/img/logo-ays.png" alt="AYS Software" class="login-logo" width="119" height="54">

        <h1 class="login-titulo">Bienvenido</h1>
        <p class="login-sub">Ingresa para consultar y actualizar los precios</p>

        <% if (locals.error) { %>
            <div class="alert alert-danger text-center py-2 small mb-3">
                <%= error %>
            </div>
        <% } %>

        <div id="cuentasGuardadas" style="display:none">
            <p class="small fw-semibold text-muted mb-2" style="letter-spacing:.02em">Cuentas guardadas en este dispositivo</p>
            <div id="listaCuentas"></div>
            <div class="separador">o ingresa con otra cuenta</div>
        </div>
        <form id="formCuenta" action="/login/guardada" method="POST" style="display:none">
            <input type="hidden" name="token" id="tokenCuenta">
        </form>

        <form action="/login" method="POST" class="mt-3">
            <div class="form-floating mb-3">
                <input type="text" class="form-control" id="username" name="username" placeholder="Usuario"
                    autocomplete="username" required>
                <label for="username">Usuario</label>
            </div>

            <div class="input-group mb-4">
                <div class="form-floating flex-grow-1">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña"
                        autocomplete="current-password" required style="border-radius: 10px 0 0 10px;">
                    <label for="password">Contraseña</label>
                </div>
                <span class="input-group-text toggle-clave" onclick="togglePassword()" role="button" aria-label="Mostrar u ocultar contraseña">
                    <i class="fa-regular fa-eye" id="toggleIcon"></i>
                </span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Ingresar</button>
            </div>
        </form>
    </div>

    <script>
        // --- CUENTAS GUARDADAS (la "cajita") ---
        // Solo se quitan cuando el usuario lo pide con los 3 puntos.
        function leerCuentas() {
            try {
                var l = JSON.parse(localStorage.getItem('ays_cuentas') || '[]');
                return Array.isArray(l) ? l.filter(function (c) { return c && c.user && c.token; }) : [];
            } catch (e) { return []; }
        }
        function guardarCuentas(l) { try { localStorage.setItem('ays_cuentas', JSON.stringify(l)); } catch (e) { } }

        function dibujarCuentas() {
            var cuentas = leerCuentas();
            var cont = document.getElementById('cuentasGuardadas');
            var lista = document.getElementById('listaCuentas');
            lista.innerHTML = '';
            cont.style.display = cuentas.length ? 'block' : 'none';
            cuentas.forEach(function (c) {
                var box = document.createElement('div');
                box.className = 'cuenta-box';

                var main = document.createElement('button');
                main.type = 'button';
                main.className = 'cuenta-main';
                var av = document.createElement('div');
                av.className = 'cuenta-avatar';
                av.textContent = c.user.charAt(0).toUpperCase();
                var txt = document.createElement('div');
                txt.style.minWidth = '0';
                var u = document.createElement('div');
                u.className = 'cuenta-user';
                u.textContent = c.user;
                var h = document.createElement('div');
                h.className = 'text-muted small';
                h.textContent = 'Toca para entrar';
                txt.appendChild(u); txt.appendChild(h);
                main.appendChild(av); main.appendChild(txt);
                main.onclick = function () {
                    document.getElementById('tokenCuenta').value = c.token;
                    document.getElementById('formCuenta').submit();
                };

                var dots = document.createElement('button');
                dots.type = 'button';
                dots.className = 'cuenta-menu-btn';
                dots.setAttribute('aria-label', 'Opciones de ' + c.user);
                dots.innerHTML = '<i class="fa-solid fa-ellipsis-vertical"></i>';

                var menu = document.createElement('div');
                menu.className = 'cuenta-menu';
                var quitar = document.createElement('button');
                quitar.type = 'button';
                quitar.textContent = 'Quitar cuenta guardada';
                quitar.onclick = function () {
                    guardarCuentas(leerCuentas().filter(function (x) { return x.user !== c.user; }));
                    dibujarCuentas();
                };
                menu.appendChild(quitar);
                dots.onclick = function (e) {
                    e.stopPropagation();
                    var abierto = menu.classList.contains('abierto');
                    document.querySelectorAll('.cuenta-menu').forEach(function (m) { m.classList.remove('abierto'); });
                    if (!abierto) menu.classList.add('abierto');
                };

                box.appendChild(main); box.appendChild(dots); box.appendChild(menu);
                lista.appendChild(box);
            });
        }
        document.addEventListener('click', function () {
            document.querySelectorAll('.cuenta-menu').forEach(function (m) { m.classList.remove('abierto'); });
        });
        dibujarCuentas();

        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggleIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }
    </script>
    <script src="/js/ui.js?v=<%= ver %>"></script>
</body>

</html>
