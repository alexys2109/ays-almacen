<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <title>Eliminar Productos</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#1e2633">
    <link rel="icon" type="image/png" href="/img/favicon-64.png">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Precios AYS">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="preload" href="/vendor/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/vendor/bootstrap/bootstrap.min.css?v=<%= vend %>" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= vend %>">
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= ver %>">
</head>

<body data-sec="eliminar">

    <nav class="sidebar">
        <div class="sidebar-header">
            <h3>AYS SOFTWARE</h3>
        </div>
        <ul class="sidebar-menu">
            <li><a href="/"><i class="fa-solid fa-magnifying-glass"></i> Buscar Productos</a></li>
            <li><a href="/modificar"><i class="fa-solid fa-pen-to-square"></i> Modificar</a></li>
            <li><a href="/agregar"><i class="fa-solid fa-circle-plus"></i> Agregar Producto</a></li>
            <li><a href="/duplicados"><i class="fa-solid fa-clone"></i> Duplicados</a></li>
            <li><a href="/eliminar-menu" class="active"><i class="fa-solid fa-trash-can"></i> Eliminar</a></li>
            <li><a href="/lista"><i class="fa-solid fa-clipboard-list"></i> Lista Almacén</a></li>
            <li style="margin-top: 40px;"><a href="/logout" class="text-danger"><i
                        class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión</a></li>
        </ul>
    </nav>
    <button class="menu-toggle-btn" onclick="document.querySelector('.sidebar').classList.toggle('active')"><i
            class="fa-solid fa-bars"></i></button>

    <div class="main-content">
        <h2>Eliminar productos</h2>
        <div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i> Eliminar es permanente.
            Revisa el nombre y los precios antes de confirmar.</div>

        <div class="card mb-3 barra-filtros">
            <div class="card-body py-3">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i
                                    class="fa-solid fa-search text-muted"></i></span>
                            <input type="text" id="buscador" class="form-control border-start-0"
                                placeholder="Buscar producto a eliminar..." autocomplete="off">
                        </div>
                    </div>
                    <div class="col-8 col-md-4">
                        <select id="filtroCategoria" class="form-select">
                            <option value="">Todas las categorías</option>
                            <% categorias.forEach(c=> { %>
                                <option value="<%= c.id %>">
                                    <%= c.nombre %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-4 col-md-2">
                        <button id="btnReset" class="btn btn-outline-secondary w-100">
                            <i class="fa-solid fa-rotate-left"></i><span class="d-none d-xl-inline"> Limpiar</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <small class="text-muted d-block mb-2 px-1" id="resumen"></small>

        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Precio al día</th>
                            <th class="num">Compra</th>
                            <th class="num">Mayor</th>
                            <th class="num">Unidad</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
            </div>
        </div>
        <div class="text-center my-3">
            <button id="btnMas" class="btn btn-outline-primary" style="display:none">Mostrar más</button>
        </div>
    </div>

    <script src="/js/similitud.js?v=<%= ver %>"></script>
    <script src="/js/frescura.js?v=<%= ver %>"></script>
    <script src="/js/ui.js?v=<%= ver %>"></script>
    <script>
        const PRODUCTOS = <%- JSON.stringify(productos).replace(/</g, '\\u003c') %>;
        const indice = Similitud.indexar(PRODUCTOS);
        PRODUCTOS.forEach(p => { p.seg_precio = Frescura.segundosPrecio(p); });

        const buscador = document.getElementById('buscador');
        const filtroCat = document.getElementById('filtroCategoria');
        const btnReset = document.getElementById('btnReset');
        const btnMas = document.getElementById('btnMas');
        const tbody = document.getElementById('tbody');
        const resumen = document.getElementById('resumen');
        const PAGINA = 50;
        let mostrar = PAGINA, temporizador;

        const dinero = v => (v === null || v === undefined || v === '') ? '—' : 'S/ ' + parseFloat(v).toFixed(2);

        function render() {
            let lista = Similitud.buscar(buscador.value, indice).map(r => r.item);
            if (filtroCat.value) lista = lista.filter(p => String(p.categoria_id) === filtroCat.value);
            if (!buscador.value.trim()) lista = lista.slice().sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

            const visibles = lista.slice(0, mostrar);
            tbody.innerHTML = visibles.map(p => `
                <tr>
                    <td data-label="ID" class="text-muted">#${p.id}</td>
                    <td data-label="Nombre">${Frescura.esc(p.nombre)}</td>
                    <td data-label="Precio al día">${Frescura.insignia(p)}</td>
                    <td data-label="Compra" class="num precio-compra"><span class="pill">${dinero(p.precio_compra)}</span></td>
                    <td data-label="Mayor" class="num precio-mayor"><span class="pill">${dinero(p.precio_mayor)}</span></td>
                    <td data-label="Unidad" class="num precio-unidad"><span class="pill">${dinero(p.precio_unidad)}</span></td>
                    <td data-label="Eliminar">
                        <a href="/eliminar/${p.id}" class="btn btn-outline-danger btn-sm w-100 btn-borrar" data-nombre="${Frescura.esc(p.nombre)}">
                            <i class="fa-solid fa-trash me-1"></i> Borrar
                        </a>
                    </td>
                </tr>`).join('') ||
                '<tr><td colspan="7" class="text-center py-5 text-muted" style="display:table-cell">No se encontraron productos.</td></tr>';

            resumen.textContent = lista.length + (lista.length === 1 ? ' producto' : ' productos') + (lista.length > visibles.length ? ' (mostrando ' + visibles.length + ')' : '');
            btnMas.style.display = lista.length > visibles.length ? '' : 'none';
        }

        function reiniciar() { mostrar = PAGINA; render(); }

        tbody.addEventListener('click', e => {
            const a = e.target.closest('.btn-borrar');
            if (a && !confirm('¿Eliminar definitivamente "' + a.dataset.nombre + '"?')) e.preventDefault();
        });
        buscador.addEventListener('input', () => { clearTimeout(temporizador); temporizador = setTimeout(reiniciar, 120); });
        filtroCat.addEventListener('change', reiniciar);
        btnMas.addEventListener('click', () => { mostrar += PAGINA; render(); });
        btnReset.addEventListener('click', () => { buscador.value = ''; filtroCat.value = ''; reiniciar(); buscador.focus(); });

        render();
    </script>
</body>

</html>
