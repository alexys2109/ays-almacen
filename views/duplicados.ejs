<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detector de Duplicados</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= ver %>">

    <style>
        .btns-simetricos {
            display: flex;
            gap: 8px;
            width: 100%;
            flex-wrap: wrap;
        }

        .btns-simetricos form,
        .btns-simetricos>a {
            flex: 1;
            margin: 0;
        }

        .btns-simetricos .btn {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 8px 5px;
            white-space: nowrap;
        }

        @media (max-width: 991px) {
            .table tbody td:last-child {
                flex-direction: row !important;
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <nav class="sidebar">
        <div class="sidebar-header">
            <h3>AYS SOFTWARE</h3>
        </div>
        <ul class="sidebar-menu">
            <li><a href="/"><i class="fa-solid fa-magnifying-glass"></i> Buscar Productos</a></li>
            <li><a href="/modificar"><i class="fa-solid fa-pen-to-square"></i> Modificar</a></li>
            <li><a href="/agregar"><i class="fa-solid fa-circle-plus"></i> Agregar Producto</a></li>
            <li><a href="/duplicados" class="active"><i class="fa-solid fa-clone"></i> Duplicados</a></li>
            <li><a href="/eliminar-menu"><i class="fa-solid fa-trash-can"></i> Eliminar</a></li>
            <li><a href="/lista"><i class="fa-solid fa-clipboard-list"></i> Lista Almacén</a></li>
            <li style="margin-top: 40px;"><a href="/logout" class="text-danger"><i
                        class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión</a></li>
        </ul>
    </nav>
    <button class="menu-toggle-btn" onclick="document.querySelector('.sidebar').classList.toggle('active')"><i
            class="fa-solid fa-bars"></i></button>

    <div class="main-content">
        <h2 style="margin-bottom:.5rem !important"><i class="fa-solid fa-clone"></i> Duplicados</h2>
        <p class="text-muted mb-3">Compara cada producto por palabras y por <b>cómo suena</b> (semola/cemola, vaso/vazo),
            sin importar el orden. Revisa cada grupo y decide: conservar uno, o marcar que son productos distintos.</p>

        <% if (grupos.length===0) { %>
            <div class="alert alert-success text-center p-5 shadow-sm">
                <i class="fa-solid fa-check-circle fa-3x mb-3"></i>
                <h4>¡Todo limpio!</h4>
                <p class="mb-0">No se encontraron productos similares por revisar.</p>
            </div>
        <% } else { %>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body py-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" id="filtroTexto" class="form-control border-start-0" placeholder="Buscar dentro de los grupos..." autocomplete="off">
                            </div>
                        </div>
                        <div class="col-12 col-md-7 chips-filtro" id="chipsNivel"></div>
                    </div>
                    <small class="text-muted d-block mt-2" id="resumenGrupos"></small>
                </div>
            </div>

            <div class="row" id="contenedorGrupos">
                <% grupos.forEach((g) => {
                    const pct = Math.round(g.score * 100);
                    const nivel = g.score >= 0.93 ? 'alta' : (g.score >= 0.86 ? 'media' : 'baja');
                    const etiqueta = { alta: ['danger', 'Muy probable duplicado'], media: ['warning', 'Probable duplicado'], baja: ['secondary', 'Posiblemente parecidos'] }[nivel];
                    const masReciente = g.items.reduce((m, p) => (m === null || (p.seg_precio !== null && (m.seg_precio === null || p.seg_precio < m.seg_precio))) ? p : m, null);
                    const ids = g.items.map(p => p.id).join(',');
                %>
                    <div class="col-12 mb-4 grupo" data-nivel="<%= nivel %>" data-texto="<%= g.items.map(p => p.nombre).join(' ').toLowerCase() %>">
                        <div class="card border-<%= etiqueta[0] %> shadow-sm">
                            <div class="card-header bg-<%= etiqueta[0] %> bg-opacity-10 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span class="fw-bold"><i class="fa-solid fa-layer-group me-2"></i> "<%= g.items[0].nombre.trim() %>"
                                    <span class="text-muted fw-normal">· <%= g.items.length %> productos</span></span>
                                <span class="badge bg-<%= etiqueta[0] %> <%= etiqueta[0]==='warning' ? 'text-dark' : '' %>"><%= etiqueta[1] %> · <%= pct %>%</span>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-bordered mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Nombre</th>
                                                <th>Precio al día</th>
                                                <th class="num">Compra</th>
                                                <th class="num">Mayor</th>
                                                <th class="num">Unidad</th>
                                                <th style="min-width: 260px;">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% g.items.forEach(p => {
                                                const otros = g.items.filter(x => x.id !== p.id).map(x => x.id).join(',');
                                            %>
                                                <tr>
                                                    <td data-label="ID" class="text-muted">#<%= p.id %></td>
                                                    <td data-label="Nombre" class="fw-bold">
                                                        <%= p.nombre %>
                                                        <% if (p.verificado) { %><span class="badge bg-light ms-1" title="Ya lo marcaste como correcto">revisado</span><% } %>
                                                        <% if (masReciente && masReciente.id === p.id) { %><span class="badge bg-success ms-1" title="Es el que tiene el precio más reciente"><i class="fa-solid fa-check me-1"></i>precio más reciente</span><% } %>
                                                    </td>
                                                    <td data-label="Precio al día"><%- Frescura.insignia(p) %></td>
                                                    <td data-label="Compra" class="num precio-compra">S/ <%= p.precio_compra === null ? '—' : parseFloat(p.precio_compra).toFixed(2) %></td>
                                                    <td data-label="Mayor" class="num precio-mayor">S/ <%= p.precio_mayor === null ? '—' : parseFloat(p.precio_mayor).toFixed(2) %></td>
                                                    <td data-label="Unidad" class="num precio-unidad">S/ <%= p.precio_unidad === null ? '—' : parseFloat(p.precio_unidad).toFixed(2) %></td>
                                                    <td data-label="Acciones">
                                                        <div class="btns-simetricos">
                                                            <form action="/api/duplicados/conservar" method="POST"
                                                                onsubmit="return confirm('Se conservará este producto y se ELIMINARÁN los otros <%= g.items.length - 1 %> del grupo. ¿Continuar?');">
                                                                <input type="hidden" name="conservar" value="<%= p.id %>">
                                                                <input type="hidden" name="eliminar" value="<%= otros %>">
                                                                <button type="submit" class="btn btn-outline-primary btn-sm" title="Conservar este y eliminar los demás del grupo">
                                                                    <i class="fa-solid fa-bullseye me-1"></i> Conservar este
                                                                </button>
                                                            </form>
                                                            <a href="/modificar?id=<%= p.id %>" class="btn btn-outline-warning btn-sm" title="Corregir nombre o precios">
                                                                <i class="fa-solid fa-pen me-1"></i> Editar
                                                            </a>
                                                            <a href="/eliminar/<%= p.id %>?origen=duplicados" class="btn btn-danger btn-sm"
                                                                onclick="return confirm('¿Eliminar definitivo?');" title="Eliminar solo este">
                                                                <i class="fa-solid fa-trash"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="p-3 bg-light d-flex justify-content-end">
                                    <form action="/api/verificar-grupo" method="POST">
                                        <input type="hidden" name="ids" value="<%= ids %>">
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="fa-solid fa-check me-1"></i> Son productos distintos (todos correctos)
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
            <div id="sinResultados" class="alert alert-light text-center" style="display:none">Ningún grupo coincide con el filtro.</div>
        <% } %>
    </div>
    <script src="//instant.page/5.2.0" type="module"></script>
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css" />

    <style>
        #nprogress .bar { background: var(--primary) !important; height: 4px !important; }
        #nprogress .peg { box-shadow: 0 0 10px var(--primary), 0 0 5px var(--primary) !important; }
        #nprogress .spinner-icon { border-top-color: var(--primary) !important; border-left-color: var(--primary) !important; }
        body.loading { cursor: wait; }
    </style>

    <script>
        NProgress.configure({ showSpinner: false, speed: 500 });

        document.querySelectorAll('.sidebar-menu a, .btn, a').forEach(link => {
            link.addEventListener('click', function (e) {
                if (this.href && this.href.startsWith(window.location.origin) && !this.getAttribute('onclick')) {
                    NProgress.start();
                    document.body.classList.add('loading');
                }
            });
        });

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function () {
                NProgress.start();
                document.body.classList.add('loading');
            });
        });

        window.addEventListener('load', function () {
            NProgress.done();
            document.body.classList.remove('loading');
        });

        window.addEventListener('pageshow', function () {
            NProgress.done();
            document.body.classList.remove('loading');
        });
    </script>

    <script>
        // Filtros de la lista de grupos (por texto y por nivel de parecido)
        (function () {
            const grupos = Array.from(document.querySelectorAll('.grupo'));
            if (!grupos.length) return;
            const chips = document.getElementById('chipsNivel');
            const txt = document.getElementById('filtroTexto');
            let nivel = '';
            const norm = s => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            function pintar() {
                const cuenta = { alta: 0, media: 0, baja: 0 };
                const q = norm(txt.value.trim());
                let visibles = 0;
                grupos.forEach(g => {
                    const okTxt = !q || norm(g.dataset.texto).includes(q);
                    if (okTxt) cuenta[g.dataset.nivel]++;
                    const ok = okTxt && (!nivel || g.dataset.nivel === nivel);
                    g.style.display = ok ? '' : 'none';
                    if (ok) visibles++;
                });
                const def = [['', 'Todos', cuenta.alta + cuenta.media + cuenta.baja], ['alta', 'Muy probables', cuenta.alta], ['media', 'Probables', cuenta.media], ['baja', 'Parecidos', cuenta.baja]];
                chips.innerHTML = def.map(([v, t, n]) => `<button type="button" class="chip${nivel === v ? ' activo' : ''}" data-n="${v}">${t}<span class="n">${n}</span></button>`).join('');
                document.getElementById('resumenGrupos').textContent = visibles + ' de ' + grupos.length + ' grupos por revisar';
                document.getElementById('sinResultados').style.display = visibles ? 'none' : '';
            }
            chips.addEventListener('click', e => { const b = e.target.closest('button[data-n]'); if (b) { nivel = b.dataset.n; pintar(); } });
            txt.addEventListener('input', pintar);
            pintar();
        })();
    </script>
    <script src="/js/ui.js?v=<%= ver %>"></script>
</body>

</html>
