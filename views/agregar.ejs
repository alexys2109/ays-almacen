<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Producto</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= ver %>">
</head>

<body data-sec="agregar">

    <nav class="sidebar">
        <div class="sidebar-header">
            <h3>AYS SOFTWARE</h3>
        </div>
        <ul class="sidebar-menu">
            <li><a href="/"><i class="fa-solid fa-magnifying-glass"></i> Buscar Productos</a></li>
            <li><a href="/modificar"><i class="fa-solid fa-pen-to-square"></i> Modificar</a></li>
            <li><a href="/agregar" class="active"><i class="fa-solid fa-circle-plus"></i> Agregar Producto</a></li>
            <li><a href="/duplicados"><i class="fa-solid fa-clone"></i> Duplicados</a></li>
            <li><a href="/eliminar-menu"><i class="fa-solid fa-trash-can"></i> Eliminar</a></li>
            <li><a href="/lista"><i class="fa-solid fa-clipboard-list"></i> Lista Almacén</a></li>
            <li style="margin-top: 40px;"><a href="/logout" class="text-danger"><i
                        class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión</a></li>
        </ul>
    </nav>
    <button class="menu-toggle-btn" onclick="document.querySelector('.sidebar').classList.toggle('active')"><i
            class="fa-solid fa-bars"></i></button>

    <div class="main-content">
        <h2 class="text-center"><i class="fa-solid fa-circle-plus"></i> Nuevo producto</h2>

        <div class="card border-0 shadow-sm mx-auto" style="max-width: 650px;">
            <div class="card-header bg-white border-0 py-3 text-center">
                <p class="text-muted mb-0 small text-uppercase fw-bold ls-1">Detalles del Producto</p>
            </div>
            <div class="card-body p-4">
                <form action="/agregar" method="POST" id="formAgregar">
                    <input type="hidden" name="token" value="<%= token %>">

                    <div class="mb-4">
                        <label class="form-label fw-bold">Nombre del Producto</label>
                        <input type="text" name="nombre" class="form-control form-control-lg"
                            placeholder="Escribe el producto" required autofocus autocomplete="off" maxlength="100">

                        <div id="panelParecidos" class="mt-3" style="display:none">
                            <div id="avisoParecidos" class="alert alert-warning small py-2 mb-2"></div>
                            <div id="listaParecidos"></div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">COMPRA</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">S/</span>
                                <input type="number" step="0.01" min="0" inputmode="decimal" name="precio_compra"
                                    class="form-control border-start-0" placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-primary small fw-bold">MAYOR</label>
                            <div class="input-group">
                                <span class="input-group-text bg-primary text-white border-end-0">S/</span>
                                <input type="number" step="0.01" min="0" inputmode="decimal" name="precio_mayor"
                                    class="form-control border-primary fw-bold" placeholder="0.00">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-success small fw-bold">UNIDAD</label>
                            <div class="input-group">
                                <span class="input-group-text bg-success text-white border-end-0">S/</span>
                                <input type="number" step="0.01" min="0" inputmode="decimal" name="precio_unidad"
                                    class="form-control border-success fw-bold" placeholder="0.00">
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Categoría <span
                                class="text-muted fw-normal">(Opcional)</span></label>
                        <select name="categoria_id" class="form-select">
                            <option value="">-- Seleccionar --</option>
                            <% categorias.forEach(c=> { %>
                                <option value="<%= c.id %>">
                                    <%= c.nombre %>
                                </option>
                                <% }) %>
                        </select>
                    </div>

                    <div class="d-grid pt-2">
                        <button type="submit" class="btn btn-success btn-lg shadow-sm">
                            GUARDAR PRODUCTO
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        if (params.get('error')) {
            const msg = params.get('error') === 'nombre'
                ? 'El nombre es demasiado largo (máximo 100 letras).'
                : 'Revisa los precios: deben ser números (0 o más).';
            Swal.fire({ title: 'No se guardó', text: msg, icon: 'error', confirmButtonColor: '#1f3d6b' })
                .then(() => { window.history.replaceState(null, null, window.location.pathname); });
        }
        if (params.get('exito') === 'true') {
            Swal.fire({
                title: '¡Listo!', text: 'Producto agregado.', icon: 'success',
                timer: 1500, showConfirmButton: false
            }).then(() => { window.history.replaceState(null, null, window.location.pathname); });
        }
    </script>

    <script src="//instant.page/5.2.0" type="module"></script>
    <script src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/nprogress@0.2.0/nprogress.css" />

    <style>
        /* Personalización de la barra (Color Azul AYS) */
        #nprogress .bar {
            background: var(--primary) !important;
            height: 4px !important;
        }

        #nprogress .peg {
            box-shadow: 0 0 10px var(--primary), 0 0 5px var(--primary) !important;
        }

        #nprogress .spinner-icon {
            border-top-color: var(--primary) !important;
            border-left-color: var(--primary) !important;
        }

        /* Cursor de espera mientras carga */
        body.loading {
            cursor: wait;
        }
    </style>

    <script>
        // Configuración
        NProgress.configure({ showSpinner: false, speed: 500 });

        // 1. Activar barra al hacer clic en enlaces del menú
        document.querySelectorAll('.sidebar-menu a, .btn, a').forEach(link => {
            link.addEventListener('click', function (e) {
                // Si es un enlace real y no tiene # (anclas)
                if (this.href && this.href.startsWith(window.location.origin) && !this.getAttribute('onclick')) {
                    NProgress.start(); // Iniciar barra
                    document.body.classList.add('loading'); // Poner cursor de reloj
                }
            });
        });

        // 2. Activar barra al enviar formularios
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function () {
                NProgress.start();
                document.body.classList.add('loading');
            });
        });

        // 3. Finalizar barra cuando la nueva página carga (se detiene sola al cambiar, pero esto asegura)
        window.addEventListener('load', function () {
            NProgress.done();
            document.body.classList.remove('loading');
        });

        // Finalizar si el usuario da al botón "Atrás" del navegador
        window.addEventListener('pageshow', function () {
            NProgress.done();
            document.body.classList.remove('loading');
        });
    </script>
    <script src="/js/similitud.js?v=<%= ver %>"></script>
    <script src="/js/frescura.js?v=<%= ver %>"></script>
    <script>
        // Avisa mientras escribes si ya existe algo igual o parecido (suena igual, mal escrito, etc.)
        const PRODUCTOS = <%- JSON.stringify(productos).replace(/</g, '\\u003c') %>;
        const indice = Similitud.indexar(PRODUCTOS);
        const inputNombre = document.querySelector('input[name="nombre"]');
        const panel = document.getElementById('panelParecidos');
        const aviso = document.getElementById('avisoParecidos');
        const listaP = document.getElementById('listaParecidos');
        const dinero = v => (v === null || v === undefined || v === '') ? '—' : 'S/ ' + parseFloat(v).toFixed(2);
        let temporizador, ultimos = [], forzarCrear = false;

        function revisar() {
            const nombre = inputNombre.value;
            ultimos = nombre.trim().length >= 2 ? Similitud.parecidos(nombre, indice) : [];
            if (!ultimos.length) { panel.style.display = 'none'; return; }
            const casiIgual = ultimos[0].score >= 0.9;
            aviso.innerHTML = casiIgual
                ? '<i class="fa-solid fa-triangle-exclamation me-1"></i> <b>Este producto parece que ya existe.</b> Revisa la lista antes de crearlo otra vez. Si lo que querías era cambiar un precio, toca el producto.'
                : '<i class="fa-solid fa-circle-info me-1"></i> <b>Hay productos parecidos.</b> Si es el mismo, tócalo para modificarlo. Si es diferente, continúa normalmente.';
            aviso.className = 'alert small py-2 mb-2 ' + (casiIgual ? 'alert-danger' : 'alert-warning');
            listaP.innerHTML = ultimos.map(r => {
                const p = r.item;
                p.seg_precio = Frescura.segundosPrecio(p);
                return `<div class="sugerencia">
                    <div class="sug-info">
                        <div class="sug-nombre">${Frescura.esc(p.nombre)}</div>
                        <div class="sug-precios">Compra ${dinero(p.precio_compra)} · Mayor ${dinero(p.precio_mayor)} · Unidad ${dinero(p.precio_unidad)}</div>
                        <div class="mt-1">${Frescura.insignia(p)}</div>
                    </div>
                    <a href="/modificar?id=${p.id}" class="btn btn-sm btn-warning text-nowrap"><i class="fa-solid fa-pen-to-square me-1"></i> Modificar este</a>
                </div>`;
            }).join('');
            panel.style.display = '';
        }
        inputNombre.addEventListener('input', () => { clearTimeout(temporizador); temporizador = setTimeout(revisar, 150); });

        // Evita guardar dos veces por doble toque: el botón se bloquea apenas se envía
        function bloquearBoton() {
            const b = document.querySelector('#formAgregar button[type=submit]');
            setTimeout(() => { b.disabled = true; b.textContent = 'GUARDANDO...'; }, 0);
        }
        window.addEventListener('pageshow', () => {
            const b = document.querySelector('#formAgregar button[type=submit]');
            if (b) { b.disabled = false; b.textContent = 'GUARDAR PRODUCTO'; }
        });

        // Si es casi idéntico a uno existente, pide confirmar antes de crearlo
        document.getElementById('formAgregar').addEventListener('submit', async (e) => {
            if (forzarCrear) return;
            if (document.querySelector('#formAgregar button[type=submit]').disabled) { e.preventDefault(); return; }
            revisar();
            if (!ultimos.length || ultimos[0].score < 0.9) { bloquearBoton(); return; }
            e.preventDefault();
            NProgress.done(); document.body.classList.remove('loading');
            const top = ultimos[0].item;
            const r = await Swal.fire({
                title: 'Ya existe un producto casi igual',
                html: '<b>' + Frescura.esc(top.nombre) + '</b><br><small>Compra ' + dinero(top.precio_compra) + ' · Mayor ' + dinero(top.precio_mayor) + ' · Unidad ' + dinero(top.precio_unidad) + '</small>',
                icon: 'warning', showCancelButton: true, showDenyButton: true,
                confirmButtonText: 'Modificar el existente', denyButtonText: 'Crear de todos modos', cancelButtonText: 'Seguir editando',
                confirmButtonColor: '#1f3d6b', denyButtonColor: '#667085'
            });
            if (r.isConfirmed) location.href = '/modificar?id=' + top.id;
            else if (r.isDenied) { forzarCrear = true; bloquearBoton(); document.getElementById('formAgregar').submit(); }
        });
    </script>
    <script src="/js/ui.js?v=<%= ver %>"></script>
</body>

</html>