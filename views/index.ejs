<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <title>Buscar Productos</title>
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="theme-color" content="#1e2633">
    <link rel="icon" type="image/png" href="/img/favicon-64.png">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Precios AYS">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="preload" href="/vendor/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/vendor/bootstrap/bootstrap.min.css?v=<%= vend %>" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= vend %>">
    <script src="/vendor/nprogress/nprogress.js?v=<%= vend %>"></script>
    <link rel="stylesheet" href="/vendor/nprogress/nprogress.css?v=<%= vend %>" />
    <link rel="stylesheet" href="/css/dashboard.css?v=<%= ver %>">
</head>

<body data-sec="buscar">
    <nav class="sidebar">
        <div class="sidebar-header">
            <h3>AYS SOFTWARE</h3>
        </div>
        <ul class="sidebar-menu">
            <li><a href="/" class="active"><i class="fa-solid fa-magnifying-glass"></i> Buscar Productos</a></li>
            <li><a href="/modificar"><i class="fa-solid fa-pen-to-square"></i> Modificar</a></li>
            <li><a href="/agregar"><i class="fa-solid fa-circle-plus"></i> Agregar Producto</a></li>
            <li><a href="/duplicados"><i class="fa-solid fa-clone"></i> Duplicados</a></li>
            <li><a href="/eliminar-menu"><i class="fa-solid fa-trash-can"></i> Eliminar</a></li>
            <li><a href="/lista"><i class="fa-solid fa-clipboard-list"></i> Lista Almacén</a></li>
            <li style="margin-top: 40px;"><a href="/logout" class="text-danger"><i
                        class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión</a></li>
        </ul>
    </nav>
    <button class="menu-toggle-btn" onclick="document.querySelector('.sidebar').classList.toggle('active')"><i
            class="fa-solid fa-bars"></i></button>

    <div class="main-content">
        <h2>Consulta de precios</h2>

        <div id="bannerOffline" class="alert alert-warning d-none align-items-center justify-content-between flex-wrap gap-2">
            <span id="bannerTexto"></span>
            <button type="button" class="btn btn-sm btn-outline-warning" onclick="location.reload()">Reintentar</button>
        </div>

        <div class="card border-0 shadow-sm mb-3 barra-filtros">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i
                                    class="fa-solid fa-search text-muted"></i></span>
                            <input type="text" id="buscador" class="form-control border-start-0"
                                placeholder="Buscar producto..." autofocus autocomplete="off">
                        </div>
                    </div>
                    <div class="col-8 col-md-4">
                        <select id="filtroCategoria" class="form-select">
                            <option value="">Todas las categorías</option>
                            <% categorias.forEach(c=> { %>
                                <option value="<%= c.id %>">
                                    <%= c.nombre %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                    <div class="col-4 col-md-2">
                        <button id="btnReset" class="btn btn-outline-secondary w-100" title="Limpiar">
                            <i class="fa-solid fa-rotate-left"></i><span class="d-none d-xl-inline"> Limpiar</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2 px-1 flex-wrap gap-2">
            <small class="text-muted" id="resumen"></small>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="tablaProductos">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th class="num">Compra</th>
                                <th class="num">Mayor</th>
                                <th class="num">Unidad</th>
                                <th>Precio al día</th>
                            </tr>
                        </thead>
                        <tbody id="tbody"></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="text-center my-3">
            <button id="btnMas" class="btn btn-outline-primary" style="display:none">Mostrar más</button>
        </div>
    </div>

    <script src="/js/similitud.js?v=<%= ver %>"></script>
    <script src="/js/frescura.js?v=<%= ver %>"></script>
    <script>
        const PRODUCTOS = <%- JSON.stringify(productos).replace(/</g, '\\u003c') %>;
        const indice = Similitud.indexar(PRODUCTOS);

        // Hora del servidor al generar esta página. Si la pantalla viene de la copia guardada (sin internet),
        // se suma el tiempo transcurrido para que "hace X días" siga siendo correcto, y se avisa claramente.
        const SERVER_NOW = <%= Date.now() %>;
        if (window.__MODO_OFFLINE) {
            const extra = Math.max(0, (Date.now() - SERVER_NOW) / 1000);
            PRODUCTOS.forEach(p => {
                if (p.seg_cambio !== null && p.seg_cambio !== undefined) p.seg_cambio = Number(p.seg_cambio) + extra;
                if (p.seg_confirmado !== null && p.seg_confirmado !== undefined) p.seg_confirmado = Number(p.seg_confirmado) + extra;
            });
            const cuando = new Date(SERVER_NOW).toLocaleString('es-PE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Lima' }).replace(/\.$/, '');
            const b = document.getElementById('bannerOffline');
            document.getElementById('bannerTexto').innerHTML = '<i class="fa-solid fa-wifi me-2"></i><b>Sin conexión.</b> Estás viendo los precios guardados el ' + cuando + '. Pueden estar desactualizados; con internet se actualizan solos.';
            b.classList.replace('d-none', 'd-flex');
            window.addEventListener('online', () => location.reload());
        }
        PRODUCTOS.forEach(p => { p.seg_precio = Frescura.segundosPrecio(p); });

        const buscador = document.getElementById('buscador');
        const filtroCat = document.getElementById('filtroCategoria');
        const btnReset = document.getElementById('btnReset');
        const btnMas = document.getElementById('btnMas');
        const tbody = document.getElementById('tbody');
        const resumen = document.getElementById('resumen');

        const PAGINA = 100;
        let mostrar = PAGINA;
        let temporizador;

        const dinero = v => (v === null || v === undefined || v === '') ? '—' : 'S/ ' + parseFloat(v).toFixed(2);

        function render() {
            const texto = buscador.value;
            const catId = filtroCat.value;

            // 1) búsqueda tolerante (ordenada por parecido) + categoría
            let lista = Similitud.buscar(texto, indice).map(r => r.item);
            if (catId) lista = lista.filter(p => String(p.categoria_id) === catId);

            // 2) orden: con texto manda el parecido; si no, A-Z
            if (!texto.trim()) lista = lista.slice().sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

            const total = lista.length;
            const visibles = lista.slice(0, mostrar);
            tbody.innerHTML = visibles.map(p => `
                <tr>
                    <td data-label="Nombre">${Frescura.esc(p.nombre)}</td>
                    <td data-label="Compra" class="num precio-compra"><span class="pill">${dinero(p.precio_compra)}</span></td>
                    <td data-label="Mayor" class="num precio-mayor"><span class="pill">${dinero(p.precio_mayor)}</span></td>
                    <td data-label="Unidad" class="num precio-unidad"><span class="pill">${dinero(p.precio_unidad)}</span></td>
                    <td data-label="Precio al día">${Frescura.insignia(p)}</td>
                </tr>`).join('') ||
                '<tr><td colspan="5" class="text-center py-5 text-muted" style="display:table-cell">No se encontraron productos.</td></tr>';

            resumen.textContent = total + (total === 1 ? ' producto' : ' productos') + (total > visibles.length ? ' (mostrando ' + visibles.length + ')' : '');
            btnMas.style.display = total > visibles.length ? '' : 'none';
        }

        function reiniciar() { mostrar = PAGINA; render(); }

        buscador.addEventListener('input', () => { clearTimeout(temporizador); temporizador = setTimeout(reiniciar, 120); });
        filtroCat.addEventListener('change', reiniciar);
        btnMas.addEventListener('click', () => { mostrar += PAGINA; render(); });
        btnReset.addEventListener('click', () => {
            buscador.value = ''; filtroCat.value = '';
            reiniciar(); buscador.focus();
        });

        render();
    </script>
    <script src="/js/ui.js?v=<%= ver %>"></script>
</body>

</html>
